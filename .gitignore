# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
__pycache__/
*.py[cod]

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# local data
/storage/
/prisma/*.db
/prisma/*.db-journal
/obsidian-vault/**
!/obsidian-vault/.gitkeep
/*.db

# desktop packaging
/desktop/node_modules
/desktop/dist
/desktop/.release/
/desktop/resources/oauth-clients.json
/desktop/data
/playwright-report/
/test-results/
/.tmp/
# agent scratch (both spellings: case collision on macOS/Windows)
/.jules/
/.Jules/
.lexopen-e2e-pg/

# Independent Android project and local visual QA captures
/relevo-android/
/docs/estetica-editorial-2026-11-07/**/*.png
/docs/estetica-editorial-2026-11-07/**/*.jpg
/docs/estetica-editorial-2026-11-07/**/*.mp4
