
# LexOpen desktop tools layered onto the pinned Debian desktop.
USER root
ARG LEXOPEN_DESKTOP_PROFILE
ARG LEXOPEN_DESKTOP_SOURCE
LABEL org.lexopen.altazor.desktop-profile="${LEXOPEN_DESKTOP_PROFILE}" \
      org.lexopen.altazor.desktop-source="${LEXOPEN_DESKTOP_SOURCE}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        libreoffice-draw libreoffice-l10n-es hunspell-es fonts-liberation \
        poppler-utils qpdf pandoc ffmpeg ripgrep zip unzip \
        python3-docx python3-openpyxl python3-pypdf python3-ebooklib python3-bs4 \
    && mkdir -p /usr/share/lexopen-desktop \
    && dpkg-query -W -f='${Package}\t${Version}\n' > /usr/share/lexopen-desktop/packages.tsv \
    && rm -rf /var/lib/apt/lists/* /etc/sudoers.d/kitty

RUN install -d -m0755 /usr/share/backgrounds/lexopen \
    && install -d -m0755 -o kitty -g kitty /home/kitty/.config/pcmanfm /home/kitty/.config/pcmanfm/default

COPY --chmod=0555 .lexopen-desktop-profile/check.py /usr/local/bin/lexopen-desktop-check
COPY --chmod=0555 .lexopen-desktop-profile/managed-install.sh /usr/local/bin/kitty-install
COPY --chmod=0555 .lexopen-desktop-profile/reading.py /usr/local/lib/lexopen-reading/reading.py
COPY --chmod=0444 .lexopen-desktop-profile/browser-read.js /usr/local/lib/lexopen-reading/browser-read.js
RUN ln -s /usr/local/lib/lexopen-reading/reading.py /usr/local/bin/lexopen-read
COPY --chmod=0644 .lexopen-desktop-profile/wallpaper.png /usr/share/backgrounds/lexopen/midnight.png
COPY --chown=kitty:kitty --chmod=0644 .lexopen-desktop-profile/desktop-items-0.conf /home/kitty/.config/pcmanfm/default/desktop-items-0.conf
USER kitty
RUN --network=none lexopen-desktop-check
