model PjudDocumentJob {
  id String @id @default(cuid())
  causaId String
  causa Causa @relation(fields:[causaId],references:[id],onDelete:Cascade)
  movimientoId String @unique
  movimiento CausaMovimiento @relation(fields:[movimientoId],references:[id],onDelete:Cascade)
  actorId String?
  actor User? @relation(fields:[actorId],references:[id],onDelete:Restrict)
  sourceRefHash String
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseToken String?
  leaseExpiresAt DateTime?
  documentoId String?
  documento Documento? @relation(fields:[documentoId],references:[id],onDelete:SetNull)
  sourceSha256 String?
  lastErrorCode String?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,nextAttemptAt])
  @@index([causaId])
}

model AltazorAcademicProfile {
  ownerId String @id
  owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  profileJson String @default("{}") @db.Text
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AltazorComputerWorkspace {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields:[ownerId],references:[id],onDelete:Restrict)
  causaId String?
  causa Causa? @relation(fields:[causaId],references:[id],onDelete:Restrict)
  scopeKey String
  endpoint String @unique
  credentialEnc String?
  providerName String
  enabled Boolean @default(false)
  dedicatedDeclaredAt DateTime
  gatewayVersion String?
  lastVerifiedAt DateTime?
  lastErrorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions AltazorComputerSession[]
  @@unique([ownerId,scopeKey])
}
model AltazorComputerSession {
  secretGrants AltazorSecretGrant[]
  connectorNamesJson String @default("[]")
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields:[ownerId],references:[id],onDelete:Restrict)
  workspaceId String
  workspace AltazorComputerWorkspace @relation(fields:[workspaceId],references:[id],onDelete:Restrict)
  requestId String
  kittyName String @unique
  kittyId String?
  chatId String?
  state String @default("creating")
  held Boolean @default(false)
  lastHelpCheckedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  actions AltazorComputerAction[]
  @@unique([ownerId,requestId])
  @@index([ownerId,workspaceId,expiresAt])
  @@index([lastHelpCheckedAt,id])
}
model AltazorComputerAction {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields:[ownerId],references:[id],onDelete:Restrict)
  sessionId String
  session AltazorComputerSession @relation(fields:[sessionId],references:[id],onDelete:Restrict)
  requestId String
  kind String
  inputHash String
  status String @default("sending")
  resultJson String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([ownerId,requestId])
  @@index([sessionId,createdAt])
}

model AltazorAcademicSearch {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requestId String
  name String
  query String
  providersJson String @default("[\"crossref\",\"openalex\"]") @db.Text
  status String @default("active")
  revision Int @default(1)
  resultsJson String @default("[]") @db.Text
  seenKeysJson String @default("[]") @db.Text
  newKeysJson String @default("[]") @db.Text
  checkedAt DateTime?
  errorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([ownerId, requestId])
  @@index([ownerId, status, updatedAt])
}
model AltazorCallSubscription {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sourceId String
  itemsJson String @default("[]") @db.Text
  checkedAt DateTime?
  lastAttemptAt DateTime?
  errorCode String?
  automatic Boolean @default(false)
  nextAttemptAt DateTime?
  failureCount Int @default(0)
  newCount Int @default(0)
  changedCount Int @default(0)
  refreshKey String?
  refreshStartedAt DateTime?
  @@unique([ownerId, sourceId])
  @@index([sourceId, automatic, nextAttemptAt])
}
model AltazorBibliographyEntry {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requestId String
  identifierKey String
  metadataJson String @db.Text
  source String
  sourceUrl String?
  checkedAt DateTime?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([ownerId, requestId])
  @@unique([ownerId, identifierKey])
  @@index([ownerId, updatedAt])
}

/// Private write-only vault. Plaintext must never enter conversation or audit records.
model AltazorSecret {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name String
  provider String
  username String?
  kind String
  ciphertext String @db.Text
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  grants AltazorSecretGrant[]
  @@index([ownerId, updatedAt])
}
/// Keyed fingerprints only; deliberately no input, plaintext or cached value.
model AltazorSecretReceipt {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requestId String
  kind String
  inputHash String
  resourceId String
  createdAt DateTime @default(now())
  @@unique([ownerId, requestId])
}
model AltazorSecretGrant {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  secretId String
  secret AltazorSecret @relation(fields: [secretId], references: [id], onDelete: Cascade)
  secretRevision Int
  sessionId String
  session AltazorComputerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  targetJson String @db.Text
  targetHash String
  sessionHash String
  state String @default("pending")
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId, sessionId, state])
  @@index([secretId, secretRevision, state])
}

/// HMAC receipt for a connector mutation; never store settings, tokens or gateway responses.
model AltazorConnectorOperation {
  id String @id @default(cuid())
  ownerId String
  workspaceId String
  requestId String
  kind String
  inputHash String
  status String @default("sending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([ownerId, requestId])
  @@index([workspaceId, status])
}

enum FeedbackCategory {
  sugerencia
  error
  otro
}

enum FeedbackStatus {
  nuevo
  en_revision
  resuelto
}

model Feedback {
  id        String           @id @default(cuid())
  ownerId   String
  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requestId String           @db.VarChar(160)
  category  FeedbackCategory
  title     String           @db.VarChar(120)
  details   String           @db.VarChar(3000)
  status    FeedbackStatus   @default(nuevo)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([ownerId, requestId])
  @@index([ownerId, createdAt, id])
  @@index([createdAt, id])
}
