generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(cuid())
  name        String   @default("Estudio LexOpen")
  rut         String?
  email       String?
  telefono   String?
  direccion   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  settings    FirmSettings?
}

model FirmSettings {
  id              String  @id @default(cuid())
  organizationId  String  @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emisorRazonSocial String?
  emisorRut       String?
  emisorGiro      String?
  emisorDireccion String?
  defaultRetencionPct Float @default(0.1375)
  ivaPct          Float   @default(0.19)
  hermesAllowDemo Boolean @default(false)
  /// manual: gestión de expedientes de cualquier país | pjud_cl: seguimiento OJV de Chile.
  caseManagementMode String @default("manual")
  /// ISO 3166-1 alpha-2. Null means the Host has not selected a country.
  workCountry     String? @db.VarChar(2)
  /// Optional staff navigation areas. Null preserves the default catalog.
  visibleSections Json?
  /// ClaveÚnica del estudio (AES-GCM) — flujo CausaMonitor / OJV Mis Causas
  claveUnicaRut            String?
  claveUnicaPasswordEnc    String?
  claveUnicaEnabled        Boolean   @default(false)
  claveUnicaLastSyncAt     DateTime?
  claveUnicaLastSyncStatus String?
  claveUnicaLastSyncNote   String?
  pjudDigestLastAt         DateTime?
  pjudDigestLastStatus     String?
  pjudDigestLastNote       String?
  /// local_only | remote_allowed — asistente Inicio / classify
  assistantLlmMode  String  @default("remote_allowed")
  /// Si true, auditoría puede guardar prompts LLM completos (solo admin)
  auditLlmPrompts   Boolean @default(false)
  /// 2FA obligatorio para roles financieros/aprobadores (admin, socio, contabilidad)
  require2faPrivileged Boolean @default(true)
}

model User {
  altazorIcaros AltazorIcaro[]
  altazorIcaroJobs AltazorIcaroJob[]
  altazorIcaroMemories AltazorIcaroMemory[]
  altazorHelpRequests AltazorHelpRequest[]
  altazorCompanion AltazorCompanion?
  driveSyncSubscriptions DriveSyncSubscription[]
  pjudDocumentJobs PjudDocumentJob[]
  pjudDownloadAuthorizations Causa[] @relation("PjudDownloadAuthorization")
  altazorSecrets AltazorSecret[]
  altazorSecretReceipts AltazorSecretReceipt[]
  altazorSecretGrants AltazorSecretGrant[]
  altazorAcademicSearches AltazorAcademicSearch[]
  altazorCallSubscriptions AltazorCallSubscription[]
  altazorBibliographyEntries AltazorBibliographyEntry[]
  computerWorkspaces AltazorComputerWorkspace[]
  computerSessions AltazorComputerSession[]
  computerActions AltazorComputerAction[]
  altazorConversations AltazorConversation[]
  altazorTurns AltazorTurn[]
  altazorAttachments AltazorAttachment[]
  altazorMemorySpaces AltazorMemorySpace[]
  personalConnectorAccounts PersonalConnectorAccount[]
  personalOAuthAttempts PersonalOAuthAttempt[]
  externalShareDrafts ExternalShareDraft[]
  externalPublicationAttempts ExternalPublicationAttempt[]
  academicWorkspaces AltazorAcademicWorkspace[]
  academicProfile AltazorAcademicProfile?
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("abogado") // admin | socio | abogado | procurador | asistente | contabilidad | externo | cliente
  /// CSV de capacidades extra / quitadas sobre el preset del rol (lib/auth/permissions)
  capabilityGrants  String @default("")
  capabilityRevokes String @default("")
  password  String
  sessionVersion Int @default(0)
  avatarColor String @default("#1f6f78")
  title     String?
  /// TOTP secret AES-GCM (enc:v2:…) when 2FA enrolled
  totpSecretEnc   String?
  totpEnabled     Boolean  @default(false)
  /// JSON array of bcrypt-hashed one-time backup codes
  totpBackupCodes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  causasAsignadas Causa[]          @relation("AbogadoResponsable")
  clientesAsignados Cliente[]      @relation("ClienteAbogado")
  documentos      Documento[]
  caseDocumentIntakes CaseDocumentIntake[]
  actividades     Activity[]
  plazos          Plazo[]
  tramites        Tramite[]        @relation("TramiteResponsable")
  siteMemberships SiteMember[]
  tasksAssigned   Task[]           @relation("TaskAssignee")
  tasksCreated    Task[]           @relation("TaskCreator")
  comments        Comment[]
  messagesSent    Message[]        @relation("MessageSender")
  messagesRecv    Message[]        @relation("MessageReceiver")
  notifications   Notification[]
  feedback        Feedback[]
  qaPosts         QaPost[]
  wikiPages       WikiPage[]
  wikiRevisions   WikiPageRevision[] @relation("WikiRevisionAuthor")
  workflowActions WorkflowInstance[] @relation("WorkflowActor")
  groupMembers    GroupMember[]
  fileVersions    FileVersion[]
  timeEntries     TimeEntry[]
  expenses        Expense[]        @relation("ExpenseAuthor")
  invoicesCreated Invoice[]        @relation("InvoiceAuthor")
  feeArrangements FeeArrangement[] @relation("FeeOwner")
  minutas         Minuta[]         @relation("MinutaAutor")
  minutaAcciones  MinutaAccion[]   @relation("MinutaAccionUser")
  auditEvents     AuditEvent[]
  timeApprovals   TimeEntry[]      @relation("TimeApprover")
  workbenchRuns   WorkbenchRun[]
  agentChats      AgentChat[]
  blogPosts       BlogPost[]       @relation("BlogAuthor")
  mailboxAccount  MailboxAccount?
  mailboxMessages MailboxMessage[]
  eventosResponsable Evento[]      @relation("EventoResponsable")
  causaMembresias CausaMiembro[]   @relation("CausaMiembroUser")
  causaMiembrosAgregados CausaMiembro[] @relation("CausaMiembroAgregadoPor")
  delegacionesOtorgadas Delegacion[] @relation("DelegacionDelegador")
  delegacionesRecibidas Delegacion[] @relation("DelegacionDelegado")
  aprobacionesSolicitadas Aprobacion[] @relation("AprobacionSolicitante")
  aprobacionesAsignadas   Aprobacion[] @relation("AprobacionAprobador")
  tasksCompleted  Task[]           @relation("TaskCompletedBy")
  taskHistorial   TaskHistorial[]
  researchRuns    ResearchRun[]

  // Notificaciones 1.1 (lib/notify)
  canalesNotificacion      CanalUsuario[]
  preferenciasNotificacion PreferenciaNotificacion[]
  perfilNotificacion       PerfilNotificacion?
  createdCaseFacts CaseFact[] @relation("FactCreator")
  caseFactReviews CaseFactReview[]
  createdCaseConflicts CaseConflict[] @relation("ConflictCreator")
  caseConflictReviews CaseConflictReview[]
  knowledgeCollections KnowledgeCollection[]
  libraryBooks LibraryBook[]
  bookShelfCollections BookShelfCollection[]
  bookShelfMemberships BookShelfMember[]
  bookPreference UserBookPreference?
  libraryWritingDrafts LibraryWritingDraft[]
  caseWritingDrafts CaseWritingDraft[]
  hearingWorkspaces HearingWorkspace[] @relation("HearingWorkspaceOwner")
  uploadedCaseAudios CaseAudio[] @relation("CaseAudioUploader")
  reviewedCaseAudios CaseAudio[] @relation("CaseAudioReviewer")
  caseAudioTranscriptRevisions CaseAudioTranscriptRevision[] @relation("CaseAudioRevisionActor")

}

model AuditEvent {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  beforeJson String?
  afterJson  String?
  ip         String?
  createdAt  DateTime @default(now())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, createdAt])
  @@index([action])
}

model Tribunal {
  id        String  @id @default(cuid())
  nombre    String  @unique
  region    String?
  competencia String?
  activo    Boolean @default(true)
}

model UfRate {
  id        String   @id @default(cuid())
  date      DateTime @unique
  valueClp  Int
  source    String   @default("manual")
  createdAt DateTime @default(now())
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  members     GroupMember[]
  siteAccess  SiteGroup[]
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

/// HighQ Site / Workspace / Data Room
model Site {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  tipo        String   @default("matter") // matter | vdr | client_portal | project | knowledge
  status      String   @default("active") // active | archived
  color       String   @default("#1f6f78")
  isClientVisible Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  causaId String? @unique
  causa   Causa?  @relation(fields: [causaId], references: [id])

  members     SiteMember[]
  groups      SiteGroup[]
  folders     Folder[]
  files       SiteFile[]
  wikiPages   WikiPage[]
  tasks       Task[]
  isheets     ISheet[]
  qaThreads   QaThread[]
  workflows   Workflow[]
  activities  Activity[]
  blogPosts   BlogPost[]
  knowledgeCollections KnowledgeCollection[]

}

model SiteMember {
  id        String   @id @default(cuid())
  siteId    String
  userId    String
  role      String   @default("contributor") // admin | contributor | viewer | client
  createdAt DateTime @default(now())
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
}

model SiteGroup {
  id      String @id @default(cuid())
  siteId  String
  groupId String
  role    String @default("viewer")
  site    Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([siteId, groupId])
}

model Cliente {
  id          String   @id @default(cuid())
  razonSocial String
  rut         String?
  email       String?
  telefono    String?
  tipo        String   @default("persona") // persona | empresa
  estado      String   @default("activo") // activo | inactivo
  notas       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  abogadoId String?
  abogado   User? @relation("ClienteAbogado", fields: [abogadoId], references: [id])

  causas          Causa[]
  documentos      Documento[]
  agentChats      AgentChat[]
  sites           Site[]
  feeArrangements FeeArrangement[]
  timeEntries     TimeEntry[]
  expenses        Expense[]
  invoices        Invoice[]
  payments        Payment[]
  ledgerEntries   LedgerEntry[]
  eventos         Evento[]
  tasks           Task[]

  @@index([razonSocial])
  @@index([rut])
  @@index([estado])
}

model Causa {
  altazorIcaros AltazorIcaro[]
  pjudDocumentDownloadsEnabled Boolean @default(false)
  pjudDocumentDownloadOwnerId String?
  pjudDocumentDownloadOwner User? @relation("PjudDownloadAuthorization", fields: [pjudDocumentDownloadOwnerId], references: [id], onDelete: Restrict)
  pjudSyncIntervalMinutes Int?
  driveSyncSubscription DriveSyncSubscription?
  pjudDocumentJobs PjudDocumentJob[]
  computerWorkspaces AltazorComputerWorkspace[]
  altazorConversations AltazorConversation[]
  altazorMemorySpaces AltazorMemorySpace[]
  id            String    @id @default(cuid())
  titulo        String
  rit           String?
  ruc           String?
  tribunal      String
  sala          String?
  /// Próxima aparición en tabla de Corte (paridad CausaMonitor salas)
  proximaTabla      DateTime?
  proximaTablaNota  String?
  cuaderno      String?
  materia       String
  procedimiento String?
  estado        String    @default("activa")
  etapa         String    @default("ingreso")
  caratula      String?
  resumen       String?
  fechaIngreso  DateTime?
  fechaNotificacion DateTime?
  abogadoContraparte String?
  conflictCheckedAt DateTime?
  conflictStatus String @default("clear") // clear | warning | blocked
  conflictNotes String?
  /// Carpeta de Google Drive vinculada a la causa (expediente digital)
  googleDriveFolderId   String?
  googleDriveFolderName String?
  googleDriveFolderUrl  String?
  /// Monitoreo estilo CaseTracking / CausaMonitor (PJUD / proveedor)
  pjudMonitoreoActivo   Boolean   @default(false)
  pjudLastSyncAt        DateTime?
  pjudNextSyncAt        DateTime?
  pjudLastSyncStatus    String?   // never | ok | partial | error | demo | disabled | failed
  pjudLastSyncNote      String?
  /// Latest verified cuaderno coverage; null for records predating coverage tracking.
  pjudCuadernosCoverage Json?
  pjudExternalKey       String?   // clave proveedor (RIT|tribunal)
  pjudFailCount         Int       @default(0)
  /// api | scrape | scrape-sidecar | claveunica | demo | import | webhook | none
  pjudSource            String?
  /// Stable intake origin: manual | claveunica | rol | csv | webhook
  pjudOrigin            String?
  pjudFromMisCausas     Boolean   @default(false)
  /// estudio (todo el staff ve, 1.0) | equipo (muro ético: solo miembros)
  acceso        String    @default("estudio")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  abogadoId String?
  abogado   User? @relation("AbogadoResponsable", fields: [abogadoId], references: [id])

  partes          Parte[]
  documentos      Documento[]
  documentFolders CaseDocumentFolder[]
  documentIntakes CaseDocumentIntake[]
  driveImports    DriveDocumentImport[]
  plazos          Plazo[]
  tramites        Tramite[]
  actividades     Activity[]
  notas           Nota[]
  minutas         Minuta[]
  site            Site?
  feeArrangements FeeArrangement[]
  timeEntries     TimeEntry[]
  expenses        Expense[]
  invoices        Invoice[]
  ledgerEntries   LedgerEntry[]
  etapaHistorial  EtapaHistorial[]
  workbenchRuns   WorkbenchRun[]
  agentChats      AgentChat[]
  movimientos     CausaMovimiento[]
  pjudSyncJobs    PjudSyncJob[]
  mailboxMessages MailboxMessage[]
  eventos         Evento[]
  miembros        CausaMiembro[]
  tasks           Task[]
  researchRuns    ResearchRun[]

  @@index([rit])
  @@index([ruc])
  @@index([estado])
  @@index([pjudMonitoreoActivo])
  @@index([pjudLastSyncAt])
  @@index([pjudNextSyncAt])
  @@index([pjudLastSyncStatus])
  // Bolt: Add database index on 'materia' to speed up list filtering in /causas
  @@index([materia])
  @@index([updatedAt])
  @@index([abogadoId])
  @@index([clienteId])
  @@index([pjudFromMisCausas])
  caseFacts CaseFact[]
  caseConflicts CaseConflict[]
  caseAnalysisSources CaseAnalysisSource[]
  knowledgeCollections KnowledgeCollection[]
  hearingWorkspaces HearingWorkspace[]
  audioRecordings CaseAudio[]
  writingDrafts CaseWritingDraft[]

}

/// Private specialist profiles. A profile never grants access beyond its owner and scope.
model AltazorIcaro {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  causaId String?
  causa Causa? @relation(fields:[causaId],references:[id],onDelete:Cascade)
  scopeKey String
  requestId String
  inputSha256 String
  name String
  instructions String @db.Text
  provider String @default("inherit")
  model String @default("")
  memoryEnabled Boolean @default(false)
  enabled Boolean @default(true)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs AltazorIcaroJob[]
  memories AltazorIcaroMemory[]
  @@unique([ownerId,requestId])
  @@index([ownerId,scopeKey,enabled])
}

/// Durable delegation with immutable input/destination snapshots and bounded execution leases.
model AltazorIcaroJob {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  icaroId String
  icaro AltazorIcaro @relation(fields:[icaroId],references:[id],onDelete:Cascade)
  requestId String
  inputSha256 String
  actorSessionVersion Int
  profileRevision Int
  instruction String @db.Text
  explicitText String @default("") @db.Text
  contextJson String @default("{}") @db.Text
  destinationJson String @db.Text
  parentJobId String?
  depth Int @default(0)
  status String @default("queued")
  result String @default("") @db.Text
  errorCode String?
  leaseToken String?
  leaseExpiresAt DateTime?
  cancelRequestedAt DateTime?
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([ownerId,requestId])
  @@index([ownerId,status,leaseExpiresAt])
  @@index([icaroId,createdAt])
}

/// Explicitly retained memories, isolated per specialist and revalidated against their sources.
model AltazorIcaroMemory {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  icaroId String
  icaro AltazorIcaro @relation(fields:[icaroId],references:[id],onDelete:Cascade)
  requestId String
  inputSha256 String
  label String
  body String @db.Text
  sourcesJson String @default("[]") @db.Text
  sourceJobId String?
  status String @default("confirmed")
  revision Int @default(1)
  forgottenAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([icaroId,requestId])
  @@index([ownerId,icaroId,status])
}

/// Human assistance stays bound to its owner and originating work; delivery does not authorize execution.
model AltazorHelpRequest {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  conversationId String?
  computerSessionId String?
  computerTurnId String?
  scopeKind String?
  scopeId String?
  status String @default("pending")
  question String @db.Text
  correlationHash String @unique
  requestKey String @unique
  response String? @db.Text
  responseSource String?
  responseMessageId String? @unique
  respondedAt DateTime?
  expiresAt DateTime
  notificationStatus String @default("pending")
  notificationAttemptedAt DateTime?
  notifiedAt DateTime?
  deliveryJson String @default("{}") @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId,status,createdAt])
  @@index([status,expiresAt])
}

model Tramite {
  id           String    @id @default(cuid())
  titulo       String
  detalle      String?
  estado       String    @default("pendiente") // pendiente | en_curso | hecho | cancelado
  fechaLimite  DateTime?
  fechaHecho   DateTime?
  orden        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  causaId String
  causa   Causa @relation(fields: [causaId], references: [id], onDelete: Cascade)

  responsableId String?
  responsable   User? @relation("TramiteResponsable", fields: [responsableId], references: [id])
  task          Task?

  @@index([causaId, estado])
  @@index([fechaLimite])
}

model EtapaHistorial {
  id        String   @id @default(cuid())
  etapa     String
  nota      String?
  createdAt DateTime @default(now())
  causaId   String
  causa     Causa    @relation(fields: [causaId], references: [id], onDelete: Cascade)
}

model CausaMovimiento {
  documentJob PjudDocumentJob?
  id          String   @id @default(cuid())
  titulo      String
  detalle     String?
  /// manual | pjud | import | demo
  fuente      String   @default("manual")
  /// proveido | resolucion | audiencia | escrito | notificacion | plazo | otro
  tipo        String   @default("otro")
  referencia  String?
  /// ID externo del proveedor para deduplicar sync
  externalId  String?
  relevante   Boolean  @default(false)
  /// Cuaderno judicial (Principal, Apelación, …) — paridad CausaMonitor
  cuaderno    String?
  folio       String?
  etapa       String?
  tramite     String?
  /// Notificación de receptor / actuación de notificación
  esReceptor  Boolean  @default(false)
  /// Escrito / presentación aún pendiente de resolución (paridad CausaMonitor)
  pendienteResolucion Boolean @default(false)
  documentoRef String?
  fecha       DateTime @default(now())
  createdAt   DateTime @default(now())
  causaId     String
  causa       Causa    @relation(fields: [causaId], references: [id], onDelete: Cascade)

  @@index([causaId, fecha])
  /// Dedup sync PJUD: skipDuplicates + unique (NULL externalId permitido N veces en PG)
  @@unique([causaId, externalId])
  @@index([tipo])
  @@index([causaId, cuaderno])
  @@index([causaId, esReceptor])
  @@index([causaId, pendienteResolucion])
}

/// Cola de sync PJUD (éxitos + fallidos reintentables), estilo CausaMonitor
model PjudSyncJob {
  id         String    @id @default(cuid())
  causaId    String
  causa      Causa     @relation(fields: [causaId], references: [id], onDelete: Cascade)
  /// pending | running | ok | partial | failed | dismissed
  status     String    @default("pending")
  /// manual | cron | retry | webhook | import
  trigger    String    @default("manual")
  attempts   Int       @default(0)
  lastError  String?
  note       String?
  inserted   Int       @default(0)
  skipped    Int       @default(0)
  pjudCuadernosCoverage Json?
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status, createdAt])
  @@index([causaId, createdAt])
  /// Índice parcial en migración: UNIQUE (causaId) WHERE status IN (pending, running)
}

model AgentChat {
  id        String   @id @default(cuid())
  title     String   @default("Consulta IA")
  messagesJson String @default("[]")
  demoMode  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  causaId   String?
  causa     Causa?   @relation(fields: [causaId], references: [id], onDelete: SetNull)
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([causaId])
}

/// Minuta post-audiencia, reunión o llamada — handoff entre abogados del estudio
model Minuta {
  id                String   @id @default(cuid())
  tipo              String   @default("reunion") // audiencia | reunion | llamada
  titulo            String
  fecha             DateTime @default(now())
  modalidad         String   @default("presencial") // presencial | videollamada | telefonica | hibrida
  lugar             String?
  participantes     String   @default("") // nombres separados por coma o JSON simple
  resumenEjecutivo  String
  hechosRelevantes  String?
  acuerdos          String?
  proximosPasos     String? // texto estructurado; también se materializan en MinutaAccion
  riesgosAlertas    String?
  estadoCausaNota   String? // cómo queda la causa tras el acto
  etapaSugerida     String? // opcional: actualizar etapa de la causa
  confidencial      Boolean  @default(false)
  googleDriveFileId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  causaId     String
  causa       Causa      @relation(fields: [causaId], references: [id], onDelete: Cascade)
  autorId     String?
  autor       User?      @relation("MinutaAutor", fields: [autorId], references: [id])
  documentoId String?
  documento   Documento? @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  acciones    MinutaAccion[]
}

/// Acción de seguimiento derivada de una minuta (continuidad de tramitación)
model MinutaAccion {
  id          String    @id @default(cuid())
  descripcion String
  responsable String? // nombre libre si aún no hay user
  fechaLimite DateTime?
  prioridad   String    @default("media") // baja | media | alta | urgente
  estado      String    @default("pendiente") // pendiente | en_curso | hecha | cancelada
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tipoComputo String?
  esFatal Boolean?
  orden Int?

  minutaId String
  minuta   Minuta @relation(fields: [minutaId], references: [id], onDelete: Cascade)
  plazoId  String?
  plazo    Plazo? @relation(fields: [plazoId], references: [id], onDelete: SetNull)
  taskId   String?
  task     Task?  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  responsableId String?
  responsableUser User? @relation("MinutaAccionUser", fields: [responsableId], references: [id], onDelete: SetNull)
}

model MinutaPlantilla {
  id        String   @id @default(cuid())
  tipo      String
  nombre    String
  materia   String?
  bodyJson  String   @default("{}")
  createdAt DateTime @default(now())
}

model Parte {
  id        String  @id @default(cuid())
  nombre    String
  rut       String?
  rol       String
  domicilio String?
  causaId   String
  causa     Causa   @relation(fields: [causaId], references: [id], onDelete: Cascade)
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  siteId    String
  parentId  String?
  createdAt DateTime @default(now())

  site     Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent   Folder?   @relation("FolderTree", fields: [parentId], references: [id])
  children Folder[]  @relation("FolderTree")
  files    SiteFile[]
}

model SiteFile {
  id          String   @id @default(cuid())
  name        String
  mimeType    String   @default("text/plain")
  sizeBytes   Int      @default(0)
  contenido   String?
  storagePath String?
  storageKey  String?
  confidencial Boolean @default(false)
  privilegio  Boolean  @default(false)
  version     Int      @default(1)
  checkedOut  Boolean  @default(false)
  tags        String   @default("")
  metadataJson String  @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  siteId   String
  folderId String?
  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  folder   Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  versions FileVersion[]
  comments Comment[]
  evidenceResource DocumentResource?
}

model FileVersion {
  id        String   @id @default(cuid())
  fileId    String
  version   Int
  contenido String?
  note      String?
  createdAt DateTime @default(now())
  authorId  String?
  storageKey String?
  mimeType String?
  sizeBytes Int?
  snapshotJson String?
  file      SiteFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id])
}

model Documento {
  pjudDocumentJobs PjudDocumentJob[]
  id            String   @id @default(cuid())
  nombre        String
  tipo          String   @default("otro")
  mimeType      String?
  contenido     String?
  ruta          String?
  storageKey    String?
  extractedMarkdown String?
  extractionStatus String?
  extractionJson String?
  extractionAttempts Int @default(0)
  extractionLockedAt DateTime?
  extractionLockToken String?
  extractionNextAttemptAt DateTime?
  confidencial  Boolean  @default(false)
  privilegio    Boolean  @default(false)
  version       Int      @default(1)
  obsidianPath  String?
  googleDriveId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  causaId String?
  causa   Causa? @relation(fields: [causaId], references: [id], onDelete: SetNull)
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  autorId String?
  autor   User?  @relation(fields: [autorId], references: [id])
  minutas Minuta[]
  evidenceResource DocumentResource?
  driveImport DriveDocumentImport?
  archivePlacement CaseDocumentPlacement?
  caseIntakes CaseDocumentIntake[]
  caseAudioSource CaseAudio? @relation("CaseAudioSourceDocument")
  caseAudioPublications CaseAudio[] @relation("CaseAudioTranscriptDocument")
  audioPublication CaseAudioPublication?
  offlineRevisions OfflineDocumentRevision[]

  @@index([causaId])
  @@index([clienteId])
  @@index([updatedAt])
  @@index([extractionStatus, extractionNextAttemptAt])
}

/// Retained revisions of a document, including the original bytes before replacement.
model OfflineDocumentRevision {
  id String @id @default(cuid())
  documentoId String
  version Int
  contenido String?
  storageKey String?
  mimeType String?
  nombre String
  confidencial Boolean
  privilegio Boolean
  causaId String?
  snapshotJson String
  createdAt DateTime @default(now())
  documento Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@unique([documentoId, version])
}

/// Virtual folders are scoped to a case. Filing does not revise the original.
model CaseDocumentFolder {
  id        String @id @default(cuid())
  causaId   String
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  causa     Causa @relation(fields: [causaId], references: [id], onDelete: Cascade)
  parent    CaseDocumentFolder? @relation("CaseDocumentFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  CaseDocumentFolder[] @relation("CaseDocumentFolderTree")
  documents CaseDocumentPlacement[]

  @@index([causaId, parentId])
}

model CaseDocumentPlacement {
  documentoId String @id
  folderId    String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  folder      CaseDocumentFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
}

/// Immutable record of an original received manually or through a case mailbox.
model CaseDocumentIntake {
  id                  String   @id @default(cuid())
  causaId             String
  documentoId         String?
  documentVersion     Int      @default(1)
  source              String
  sourceKey           String
  sourceSha256        String?
  sourceName          String
  storageKey          String?
  actorId             String?
  mailboxAttachmentId String?  @unique
  receivedAt          DateTime @default(now())
  causa               Causa    @relation(fields: [causaId], references: [id], onDelete: Cascade)
  documento           Documento? @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  actor               User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  mailboxAttachment   MailboxAttachment? @relation(fields: [mailboxAttachmentId], references: [id], onDelete: SetNull)

  @@unique([causaId, source, sourceKey])
  @@index([causaId, sourceSha256])
  @@index([causaId, receivedAt, id])
  @@index([documentoId])
  @@index([actorId])
}

model Plazo {
  id            String   @id @default(cuid())
  titulo        String
  descripcion   String?
  fechaLimite   DateTime
  fechaNotificacion DateTime?
  diasPlazo     Int?
  calculationCountry String?
  calculationRegime String?
  tipoComputo   String   @default("habiles") // habiles | corridos
  esFatal       Boolean  @default(false)
  tipo          String   @default("procesal")
  estado        String   @default("pendiente")
  alertaEnviada Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  causaId       String?
  causa         Causa? @relation(fields: [causaId], references: [id], onDelete: Cascade)
  responsableId String?
  responsable   User?  @relation(fields: [responsableId], references: [id])
  minutaAcciones MinutaAccion[]
  tasks         Task[]

  alertas        PlazoAlerta[]

  @@index([fechaLimite])
  @@index([estado])
  @@index([estado, fechaLimite])
  @@index([responsableId, fechaLimite])
}

model Nota {
  id        String   @id @default(cuid())
  titulo    String
  contenido String
  tags      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  causaId   String?
  causa     Causa?   @relation(fields: [causaId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  tipo      String
  mensaje   String
  createdAt DateTime @default(now())

  causaId String?
  causa   Causa? @relation(fields: [causaId], references: [id], onDelete: Cascade)
  siteId  String?
  site    Site?  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  userId  String?
  user    User?  @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId, createdAt])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  instructions String?
  considerations String?
  status      String    @default("todo") // todo | in_progress | blocked | waiting_client | done | cancelled
  priority    String    @default("medium") // low | medium | high | urgent
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// manual | minuta | pjud | checklist | tramite | asistente | voz | intake | aprobacion
  origen      String    @default("manual")
  /// RRULE simple (FREQ=DAILY|WEEKLY|MONTHLY;INTERVAL=n) — al completar se crea la siguiente
  rrule       String?
  /// Snooze / «recuérdame»
  remindAt    DateTime?
  completedAt DateTime?
  /// cliente | tribunal | contraparte | interno
  waitingOn   String?

  causaId     String?
  causa       Causa?    @relation(fields: [causaId], references: [id], onDelete: SetNull)
  clienteId   String?
  cliente     Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  plazoId     String?
  plazo       Plazo?    @relation(fields: [plazoId], references: [id], onDelete: SetNull)
  eventoId    String?
  evento      Evento?   @relation(fields: [eventoId], references: [id], onDelete: SetNull)
  /// Espejo 1:1 de un Tramite (checklist de causa)
  tramiteId   String?   @unique
  tramite     Tramite?  @relation(fields: [tramiteId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Task?     @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]    @relation("TaskSubtasks")
  completedById String?
  completedBy User?     @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  historial   TaskHistorial[]

  siteId     String?
  site       Site? @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId  String?
  creator    User? @relation("TaskCreator", fields: [creatorId], references: [id])

  comments Comment[]
  minutaAcciones MinutaAccion[]

  @@index([assigneeId])
  @@index([siteId])
  @@index([status])
  @@index([dueDate])
  @@index([causaId])
  @@index([assigneeId, status, dueDate])
  @@index([origen])
  @@index([parentId])
}

/// Historial auditable de cambios de asignado/estado de un pendiente
model TaskHistorial {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// creada | estado | asignado | posponer | delegada
  campo     String
  antes     String?
  despues   String?
  nota      String?
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model WikiPage {
  id        String   @id @default(cuid())
  title     String
  slug      String
  content   String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  siteId   String
  site     Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  authorId String?
  author   User? @relation(fields: [authorId], references: [id])
  revisions WikiPageRevision[]

  @@unique([siteId, slug])
}

model WikiPageRevision {
  id        String   @id @default(cuid())
  pageId    String
  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())
  authorId  String?
  author    User?    @relation("WikiRevisionAuthor", fields: [authorId], references: [id])

  @@index([pageId])
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @default("")
  body      String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("BlogAuthor", fields: [authorId], references: [id])

  @@unique([siteId, slug])
}

/// HighQ iSheets — structured collaborative tables
model ISheet {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  siteId  String
  site    Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  columns ISheetColumn[]
  rows    ISheetRow[]
}

model ISheetColumn {
  id       String @id @default(cuid())
  sheetId  String
  name     String
  key      String
  type     String @default("text") // text | number | date | choice | user | checkbox
  options  String @default("") // comma-separated for choice
  position Int    @default(0)
  sheet    ISheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@unique([sheetId, key])
}

model ISheetRow {
  id        String   @id @default(cuid())
  sheetId   String
  dataJson  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sheet     ISheet   @relation(fields: [sheetId], references: [id], onDelete: Cascade)
}

model QaThread {
  id        String   @id @default(cuid())
  subject   String
  status    String   @default("open") // open | answered | closed
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  siteId String
  site   Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  posts  QaPost[]
}

model QaPost {
  id        String   @id @default(cuid())
  body      String
  isAnswer  Boolean  @default(false)
  createdAt DateTime @default(now())

  threadId String
  thread   QaThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?    @relation(fields: [authorId], references: [id])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  authorId String?
  author   User?     @relation(fields: [authorId], references: [id])
  fileId   String?
  file     SiteFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)
  taskId   String?
  task     Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Message {
  id         String   @id @default(cuid())
  subject    String?
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  senderId   String
  receiverId String
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  read      Boolean  @default(false)
  href      String?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Catálogo lib/notify/catalog.ts (plazo.fatal, tarea.asignada, …)
  tipo       String    @default("general")
  /// critica | alta | media | baja
  severidad  String    @default("media")
  entityType String?
  entityId   String?
  dedupeKey  String?   @unique
  ackAt      DateTime?
  /// inapp | telegram | push | email
  ackVia     String?

  @@index([userId, createdAt])
  @@index([userId, read])
  @@index([entityType, entityId])
}

model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  triggerType String   @default("manual") // manual | file_upload | task_done | isheet_row
  stepsJson   String   @default("[]") // [{name, role}]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  siteId    String
  site      Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  instances WorkflowInstance[]
}

model WorkflowInstance {
  id          String   @id @default(cuid())
  workflowId  String
  status      String   @default("pending") // pending | approved | rejected | running
  currentStep Int      @default(0)
  payloadJson String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  actorId  String?
  actor    User?     @relation("WorkflowActor", fields: [actorId], references: [id])
  workflow Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model Jurisprudencia {
  id          String    @id @default(cuid())
  rol         String
  tribunal    String
  sala        String?
  fecha       DateTime?
  materia     String?
  caratula    String?
  descripcion String?
  doctrina    String?
  texto       String?
  url         String?
  fuente      String    @default("LexOpen")
  tags        String    @default("")
  createdAt   DateTime  @default(now())
}

model IntegrationConfig {
  id         String   @id @default(cuid())
  provider   String   @unique
  enabled    Boolean  @default(false)
  configJson String   @default("{}")
  updatedAt  DateTime @updatedAt
}

/// Condición de honorarios del estudio (por causa o cliente)
model FeeArrangement {
  id              String    @id @default(cuid())
  name            String
  tipo            String    @default("hourly") // hourly | flat | retainer | cuota_litis | mixed
  currency        String    @default("CLP") // CLP | UF
  rateHourlyClp   Int? // tarifa horaria en CLP
  rateHourlyUf    Float?
  flatFeeClp      Int?
  retainerClp     Int?
  cuotaLitisPct   Float? // % del resultado
  billingCapClp   Int?
  notes           String?
  active          Boolean   @default(true)
  startDate       DateTime  @default(now())
  endDate         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  causaId   String?
  causa     Causa?   @relation(fields: [causaId], references: [id], onDelete: Cascade)
  ownerId   String?
  owner     User?    @relation("FeeOwner", fields: [ownerId], references: [id])
}

model TimeEntry {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  hours       Float
  description String
  billable    Boolean  @default(true)
  billed      Boolean  @default(false)
  approved    Boolean  @default(false)
  rateClp     Int? // override; si null usa fee arrangement / default
  amountClp   Int // hours * rate (calculado al guardar)
  activityCode String  @default("general") // research | hearing | drafting | meeting | travel | general
  minutaId    String?
  startedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  approverId String?
  approver  User?    @relation("TimeApprover", fields: [approverId], references: [id])
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  causaId   String?
  causa     Causa?   @relation(fields: [causaId], references: [id], onDelete: SetNull)
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  description String
  category    String   @default("otro") // notario | receptor | perito | costas | traslado | certificado | otro
  amountClp   Int
  billable    Boolean  @default(true)
  billed      Boolean  @default(false)
  reimbursable Boolean @default(true) // gasto por cuenta del cliente
  vendor      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId  String?
  author    User?    @relation("ExpenseAuthor", fields: [authorId], references: [id])
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  causaId   String?
  causa     Causa?   @relation(fields: [causaId], references: [id], onDelete: SetNull)
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}

model Invoice {
  id            String    @id @default(cuid())
  number        String    @unique
  tipoDocumento String    @default("boleta_honorarios") // factura_afecta | boleta_honorarios | nota_credito | factura_exenta
  status        String    @default("borrador") // borrador | emitida | parcialmente_pagada | pagada | vencida | anulada
  currency      String    @default("CLP")
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  subtotalClp   Int       @default(0)
  ivaClp        Int       @default(0) // 19% si factura afecta
  retencionClp  Int       @default(0) // retención boleta honorarios
  totalClp      Int       @default(0)
  paidClp       Int       @default(0)
  notes         String?
  glosa         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])
  causaId   String?
  causa     Causa?  @relation(fields: [causaId], references: [id], onDelete: SetNull)
  authorId  String?
  author    User?   @relation("InvoiceAuthor", fields: [authorId], references: [id])

  lines       InvoiceLine[]
  payments    Payment[]
  timeEntries TimeEntry[]
  expenses    Expense[]
  ledger      LedgerEntry[]
}

model InvoiceLine {
  id          String @id @default(cuid())
  description String
  quantity    Float  @default(1)
  unitAmountClp Int
  amountClp   Int
  tipo        String @default("honorario") // honorario | gasto | anticipo | otro
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  amountClp   Int
  method      String   @default("transferencia") // transferencia | cheque | efectivo | tarjeta | retencion
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())

  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  ledger    LedgerEntry[]
}

/// Cuenta corriente / provisión de fondos del cliente
model LedgerEntry {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  tipo        String // provision | cargo_honorario | cargo_gasto | pago | ajuste | reembolso
  description String
  debitClp    Int      @default(0) // cargo al cliente
  creditClp   Int      @default(0) // abono / provisión / pago
  balanceClp  Int      @default(0) // saldo tras el movimiento (crédito neto)
  createdAt   DateTime @default(now())

  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  causaId   String?
  causa     Causa?   @relation(fields: [causaId], references: [id], onDelete: SetNull)
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
}

/// Buzón profesional por usuario (Gmail / Microsoft / IMAP). Solo ingest pjud.cl.
model MailboxAccount {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// gmail | microsoft | imap
  protocol        String    @default("imap")
  /// disconnected | connected | error
  status          String    @default("disconnected")
  email           String?
  imapHost        String?
  imapPort        Int       @default(993)
  imapTls         Boolean   @default(true)
  passwordEnc     String?
  oauthRefreshEnc String?
  oauthAccessEnc  String?
  oauthExpiresAt  DateTime?
  lastError       String?
  lastSyncAt      DateTime?
  imapUidValidity Int?
  imapLastUid     Int?
  gmailHistoryId  String?
  graphDeltaLink  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messages        MailboxMessage[]
}

model MailboxMessage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     MailboxAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId  String?
  kind        String   @default("otro") // resolucion | causa_general | tablas | otro
  status      String   @default("nuevo") // nuevo | vinculado | aplicado | descartado
  subject     String
  fromAddress String?
  receivedAt  DateTime
  bodyText    String   @db.Text
  parsedJson  String?  @db.Text
  rit         String?
  tribunal    String?
  causaId     String?
  causa       Causa?   @relation(fields: [causaId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  attachments MailboxAttachment[]

  @@unique([userId, externalId])
  @@index([userId, status])
  @@index([causaId])
}

model MailboxAttachment {
  id          String   @id @default(cuid())
  messageId   String
  message     MailboxMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename    String
  mimeType    String?
  sha256      String
  sizeBytes   Int      @default(0)
  storageKey  String?
  documentoId String?
  siteFileId  String?
  createdAt   DateTime @default(now())
  caseIntake  CaseDocumentIntake?

  @@unique([messageId, sha256])
  @@index([documentoId])
}

/// Agenda del estudio: audiencias, reuniones, recordatorios, vencimientos
model Evento {
  id            String   @id @default(cuid())
  titulo        String
  /// audiencia | reunion | recordatorio | vencimiento | otro
  tipo          String   @default("reunion")
  inicio        DateTime
  fin           DateTime?
  todoElDia     Boolean  @default(false)
  lugar         String?
  /// presencial | videollamada | telefonica | hibrida | tribunal
  modalidad     String?
  enlace        String?
  notas         String?
  /// programado | cancelado | realizado
  estado        String   @default("programado")
  /// Solo si tipo=audiencia
  tipoAudiencia String?
  tribunal      String?
  googleEventId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  causaId       String?
  causa         Causa?   @relation(fields: [causaId], references: [id], onDelete: SetNull)
  clienteId     String?
  cliente       Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  responsableId String
  responsable   User     @relation("EventoResponsable", fields: [responsableId], references: [id])
  tasks         Task[]

  @@index([inicio])
  @@index([tipo, estado])
  @@index([causaId])
  @@index([responsableId])
  @@index([responsableId, inicio])
}

/// Equipo de la causa. Con `Causa.acceso = "equipo"` solo estos miembros (y quien
/// tenga `causa.override_walls`) ven la causa.
model CausaMiembro {
  id            String    @id @default(cuid())
  causaId       String
  causa         Causa     @relation(fields: [causaId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation("CausaMiembroUser", fields: [userId], references: [id], onDelete: Cascade)
  /// responsable | colaborador | procurador | supervisor | externo | lectura
  rol           String    @default("colaborador")
  desde         DateTime  @default(now())
  hasta         DateTime?
  agregadoPorId String?
  agregadoPor   User?     @relation("CausaMiembroAgregadoPor", fields: [agregadoPorId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@unique([causaId, userId])
  @@index([userId])
}

/// «X gestiona la agenda/tareas de Y» o cobertura por vacaciones, con vigencia.
model Delegacion {
  id          String    @id @default(cuid())
  delegadorId String
  delegador   User      @relation("DelegacionDelegador", fields: [delegadorId], references: [id], onDelete: Cascade)
  delegadoId  String
  delegado    User      @relation("DelegacionDelegado", fields: [delegadoId], references: [id], onDelete: Cascade)
  /// CSV de capacidades delegadas (evento.manage, task.assign, notify.receive_copy)
  alcance     String    @default("task.assign")
  desde       DateTime  @default(now())
  hasta       DateTime?
  activa      Boolean   @default(true)
  motivo      String?
  createdAt   DateTime  @default(now())

  @@index([delegadoId, activa])
  @@index([delegadorId, activa])
}

/// Aprobación genérica ligada a cualquier entidad (escrito, horas, factura, muro…)
model Aprobacion {
  id            String    @id @default(cuid())
  /// escrito | time_batch | invoice | gasto | descuento | override_walls | envio_cliente
  tipo          String
  titulo        String
  detalle       String?
  entityType    String
  entityId      String
  solicitanteId String?
  solicitante   User?     @relation("AprobacionSolicitante", fields: [solicitanteId], references: [id], onDelete: SetNull)
  aprobadorId   String?
  aprobador     User?     @relation("AprobacionAprobador", fields: [aprobadorId], references: [id], onDelete: SetNull)
  /// pendiente | aprobada | rechazada | expirada | cancelada
  estado        String    @default("pendiente")
  comentario    String?
  venceAt       DateTime?
  createdAt     DateTime  @default(now())
  resueltaAt    DateTime?
  resueltaPorId String?

  @@index([aprobadorId, estado])
  @@index([entityType, entityId])
  @@index([estado, createdAt])
}

// ─── Notificaciones 1.1: canales, preferencias, outbox y cola (lib/notify, lib/jobs) ───

/// Canal externo vinculado por un usuario (Telegram, Web Push; WhatsApp en 1.2).
model CanalUsuario {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// telegram | push | whatsapp
  canal          String
  /// chat_id / PushSubscription JSON cifrado (AES-GCM, lib/notify/secrets)
  destinoEnc     String    @default("")
  /// HMAC del destino para dedupe sin descifrar; "pendiente:<rand>" antes de vincular
  destinoHash    String
  /// pendiente | activo | bloqueado | revocado | error
  estado         String    @default("pendiente")
  /// minimo | estandar | detallado
  nivelDetalle   String    @default("minimo")
  etiqueta       String?
  /// SHA-256 del código de vinculación de un uso (Telegram /start)
  codigoHash     String?
  codigoExpiraAt DateTime?
  verificadoAt   DateTime?
  ultimoUsoAt    DateTime?
  ultimoErrorAt  DateTime?
  ultimoError    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([canal, destinoHash])
  @@index([userId, canal])
  @@index([codigoHash])
}

/// Modo por (tipo, canal); tipo "*" aplica a todo el catálogo.
model PreferenciaNotificacion {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo   String
  /// inapp | email | telegram | push
  canal  String
  /// realtime | digest_diario | digest_semanal | off
  modo   String @default("realtime")

  @@unique([userId, tipo, canal])
}

/// Horas de silencio y nivel de detalle del email por usuario.
model PerfilNotificacion {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quietDesde       String    @default("21:00")
  quietHasta       String    @default("08:00")
  quietFinesSemana Boolean   @default(true)
  zonaHoraria      String    @default("America/Santiago")
  nivelEmail       String    @default("estandar")
  silenciadoHasta  DateTime?
  updatedAt        DateTime  @updatedAt
}

/// Outbox: una fila por destinatario y canal; el payload ya va minimizado.
model MensajeSaliente {
  id                 String          @id @default(cuid())
  notificationId     String?
  userId             String
  /// email | telegram | push
  canal              String
  canalUsuarioId     String?
  plantilla          String
  payloadJson        String          @default("{}")
  nivelDetalle       String          @default("minimo")
  dedupeKey          String          @unique
  /// 0 crítico … 9 digest
  prioridad          Int             @default(5)
  /// encolado | digest | enviando | enviado | fallido | muerto | suprimido
  estado             String          @default("encolado")
  intentos           Int             @default(0)
  proximoIntentoAt   DateTime        @default(now())
  lockedAt           DateTime?
  lockedBy           String?
  envioIniciadoAt    DateTime?
  digestMode         String?
  proveedor          String?
  proveedorMessageId String?
  error              String?
  createdAt          DateTime        @default(now())
  enviadoAt          DateTime?
  eventos            EventoEntrega[]

  @@index([estado, proximoIntentoAt, prioridad])
  @@index([userId, createdAt])
  @@index([notificationId])
  @@index([estado, lockedAt])
}

model EventoEntrega {
  id        String          @id @default(cuid())
  mensajeId String
  mensaje   MensajeSaliente @relation(fields: [mensajeId], references: [id], onDelete: Cascade)
  estado    String
  detalle   String?
  at        DateTime        @default(now())

  @@index([mensajeId, at])
}

/// Cola genérica Postgres (SELECT … FOR UPDATE SKIP LOCKED).
model Job {
  id          String    @id @default(cuid())
  tipo        String
  payloadJson String    @default("{}")
  /// pendiente | corriendo | ok | fallido | muerto
  estado      String    @default("pendiente")
  runAt       DateTime  @default(now())
  intentos    Int       @default(0)
  maxIntentos Int       @default(5)
  lockedAt    DateTime?
  lockedBy    String?
  dedupeKey   String?   @unique
  lastError   String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([estado, runAt])
}

/// Hitos de alerta por plazo (T-7, T-3, T-1, T-0, escalamiento) con acuse.
model PlazoAlerta {
  id         String    @id @default(cuid())
  plazoId    String
  plazo      Plazo     @relation(fields: [plazoId], references: [id], onDelete: Cascade)
  hito       String
  generadaAt DateTime  @default(now())
  ackAt      DateTime?
  ackById    String?
  ackVia     String?

  @@unique([plazoId, hito])
  @@index([hito, ackAt])
}

/// Durable assistant state. Business writes and command results commit together.
model AssistantPlanRecord {
  id          String @id
