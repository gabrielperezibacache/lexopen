  key        String @unique
  ownerId    String
  inputHash  String
  status     String @default("running")
  resultJson String? @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AssistantUndo {
  id           String @id
  ownerId      String
  toolId       String
  entityType   String
  entityId     String
  payloadJson  String @db.Text
  expectedJson String @db.Text
  consumedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([ownerId, expiresAt])
}

/// Common evidence identity; scope always comes from its live source object.
model DocumentResource {
  id          String @id @default(cuid())
  documentoId String? @unique
  documento   Documento? @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  siteFileId  String? @unique
  siteFile    SiteFile? @relation(fields: [siteFileId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  versions    DocumentEvidenceVersion[]
}

/// Append-only extracted text, linked to a hashed original and stable locators.
model DocumentEvidenceVersion {
  id               String @id @default(cuid())
  resourceId       String
  resource         DocumentResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  sourceSha256     String
  textSha256       String
  sourceRevision String @default("legacy")
  extractorVersion String
  sourceName       String
  sourceMimeType   String?
  sourceStorageKey String?
  extractedText    String @db.Text
  extractionStatus String
  metadataJson     String @default("{}") @db.Text
  createdAt        DateTime @default(now())
  fragments        DocumentEvidenceFragment[]
  pages            DocumentEvidencePage[]
  pageCount        Int?
  locatorKind      String @default("text-offset")

  @@unique([resourceId, sourceSha256, textSha256, extractorVersion, sourceRevision], map: "EvidenceVersion_content_key")
  @@index([resourceId, createdAt])
}

model DocumentEvidenceFragment {
  id          String @id @default(cuid())
  versionId   String
  version     DocumentEvidenceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  ordinal     Int
  text        String @db.Text
  textSha256  String
  startOffset Int
  endOffset   Int
  pageId      String?
  page        DocumentEvidencePage? @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageStartOffset Int?
  pageEndOffset   Int?

  @@unique([versionId, ordinal])
}

model DocumentEvidencePage {
  id          String @id @default(cuid())
  versionId   String
  version     DocumentEvidenceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  pageNumber  Int
  text        String @db.Text
  textSha256  String
  method      String
  status      String
  reason      String?
  fragments   DocumentEvidenceFragment[]

  @@unique([versionId, pageNumber])
}

model LegalSource {
  id           String @id @default(cuid())
  canonicalUrl String @unique
  title        String
  organism     String
  kind         String
  externalId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  versions     LegalSourceVersion[]
}

model LegalSourceVersion {
  id               String @id @default(cuid())
  sourceId         String
  source           LegalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceSha256     String
  textSha256       String
  text             String @db.Text
  sourceStorageKey String?
  title            String
