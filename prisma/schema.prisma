  acquisitionMethod String @default("retrieved")
  metadataJson     String @default("{}") @db.Text
  createdAt        DateTime @default(now())
  fragments        LegalSourceFragment[]

  @@unique([sourceId, sourceSha256, textSha256])
  @@index([sourceId, createdAt])
  @@index([kind, publishedAt])
}

model LegalSourceFragment {
  id          String @id @default(cuid())
  versionId   String
  version     LegalSourceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  ordinal     Int
  text        String @db.Text
