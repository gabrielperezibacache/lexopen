}

model ResearchRun {
  id         String @id @default(cuid())
  ownerId    String
  owner      User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  causaId    String?
  causa      Causa? @relation(fields: [causaId], references: [id], onDelete: Cascade)
  query      String @db.Text
  scopeJson  String @db.Text
  resultJson String @db.Text
  status     String
  createdAt  DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([causaId])
}

/// Preserves every divergent row before the historical PJUD dedupe runs.
model PjudMigrationArchive {
  id           String @id
  sourceTable  String
  sourceId     String
  survivorId   String
  snapshotJson Json
  reason       String
  archivedAt   DateTime @default(now())

  @@unique([sourceTable, sourceId])
}

/// Immutable provenance and idempotency of an explicitly selected Drive revision.
model DriveDocumentImport {
  id String @id @default(cuid())
  causaId String
  documentoId String? @unique
  folderId String
  driveFileId String
  driveVersion String
  exportMimeType String
  sourceSha256 String
  metadataJson String @default("{}") @db.Text
  importedAt DateTime @default(now())
  causa Causa @relation(fields: [causaId], references: [id], onDelete: Cascade)
  documento Documento? @relation(fields: [documentoId], references: [id], onDelete: SetNull)

  @@unique([causaId, driveFileId, driveVersion, exportMimeType])
  @@index([causaId, importedAt])
}

/// Reviewed factual propositions; source excerpts remain separately identified.
model CaseFact {
  id String @id @default(cuid())
  causaId String
  statement String @db.Text
  dateLiteral String?
  dateStart DateTime?
  dateEnd DateTime?
  datePrecision String @default("unknown")
  dateInferred Boolean @default(false)
  status String @default("proposed")
  highlighted Boolean @default(false)
  revision Int @default(1)
  fingerprint String
  comparisonKey String?
  origin String @default("manual")
  metadataJson String @default("{}") @db.Text
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  causa Causa @relation(fields:[causaId],references:[id],onDelete:Cascade)
  createdBy User @relation("FactCreator",fields:[createdById],references:[id])
  citations CaseFactCitation[]
  reviews CaseFactReview[]
  leftConflicts CaseConflict[] @relation("ConflictLeft")
  rightConflicts CaseConflict[] @relation("ConflictRight")
  @@unique([causaId,fingerprint])
  @@index([causaId,dateStart])
}
model CaseFactCitation {
  id String @id @default(cuid())
  factId String
  citationJson String @db.Text
  sourceKey String
  fact CaseFact @relation(fields:[factId],references:[id],onDelete:Cascade)
  @@unique([factId,sourceKey])
}
model CaseFactReview {
  id String @id @default(cuid())
  factId String
  actorId String
  fromRevision Int
  toRevision Int
  beforeJson String @db.Text
  afterJson String @db.Text
  createdAt DateTime @default(now())
  fact CaseFact @relation(fields:[factId],references:[id],onDelete:Cascade)
  actor User @relation(fields:[actorId],references:[id])
  @@index([factId,createdAt])
}
model CaseConflict {
  id String @id @default(cuid())
  causaId String
  leftFactId String
  rightFactId String
  kind String
  reason String @db.Text
  metadataJson String @default("{}") @db.Text
  status String @default("proposed")
  revision Int @default(1)
  fingerprint String
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  causa Causa @relation(fields:[causaId],references:[id],onDelete:Cascade)
  leftFact CaseFact @relation("ConflictLeft",fields:[leftFactId],references:[id],onDelete:Cascade)
  rightFact CaseFact @relation("ConflictRight",fields:[rightFactId],references:[id],onDelete:Cascade)
  createdBy User @relation("ConflictCreator",fields:[createdById],references:[id])
  reviews CaseConflictReview[]
  @@unique([causaId,fingerprint])
  @@index([causaId,createdAt])
}
model CaseConflictReview {
  id String @id @default(cuid())
  conflictId String
  actorId String
  fromRevision Int
  toRevision Int
  beforeJson String @db.Text
  afterJson String @db.Text
  createdAt DateTime @default(now())
  conflict CaseConflict @relation(fields:[conflictId],references:[id],onDelete:Cascade)
  actor User @relation(fields:[actorId],references:[id])
  @@index([conflictId,createdAt])
}
model CaseAnalysisSource {
  id String @id @default(cuid())
  causaId String
  versionId String
  extractorVersion String
  afterOrdinal Int @default(0)
  completed Boolean @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  causa Causa @relation(fields:[causaId],references:[id],onDelete:Cascade)
  @@unique([causaId,versionId,extractorVersion])
}
model KnowledgeCollection {
  id String @id @default(cuid())
  ownerId String
  causaId String?
  siteId String?
  name String
  instructions String @default("") @db.Text
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  causa Causa? @relation(fields:[causaId],references:[id],onDelete:Cascade)
