[Unit]
Description=LexOpen local web Host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lexopen
Group=lexopen
WorkingDirectory=/opt/lexopen
Environment=NODE_ENV=production
Environment=LEXOPEN_APP_ROOT=/opt/lexopen/.next/standalone
Environment=LEXOPEN_PRISMA_ROOT=/opt/lexopen/prisma
Environment=LEXOPEN_DATA_DIR=/var/lib/lexopen
# Fail-closed demos / CI relaxations (override demos in data-dir .env only if intentional)
Environment=LEXOPEN_DEMO_SWITCHER=0
Environment=HERMES_ALLOW_DEMO=0
Environment=LLM_ALLOW_DEMO=0
Environment=PJUD_ALLOW_DEMO=0
Environment=LEXOPEN_RELAX_CSRF=0
Environment=LEXOPEN_OPEN_ACCESS=0
Environment=LEXOPEN_ALLOW_PLAINTEXT_PASSWORDS=0
ExecStart=/usr/bin/node /opt/lexopen/scripts/web-host.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lexopen /var/lib/lexopen-backups

[Install]
WantedBy=multi-user.target
