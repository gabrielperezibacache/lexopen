# Local / CI: Postgres
DATABASE_URL="postgresql://lexopen:lexopen@localhost:5432/lexopen"
# Producción: use Render Blueprint (fromDatabase)

SESSION_SECRET=change-me-in-production
# Solo desarrollo: permite UserSwitcher entre usuarios demo
LEXOPEN_DEMO_SWITCHER=1
# Token de una sola vez para /setup (primer admin tras purge o instalación limpia)
# LEXOPEN_BOOTSTRAP_TOKEN=
# Emergencia/demo: desactiva middleware de auth (nunca en prod; instrumentation falla si =1)
# LEXOPEN_OPEN_ACCESS=1
# Nunca en prod (instrumentation falla si =1): LEXOPEN_RELAX_CSRF, LEXOPEN_ALLOW_PLAINTEXT_PASSWORDS, LEXOPEN_DEMO_SWITCHER

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

HERMES_API_URL=http://localhost:8642/v1
HERMES_API_KEY=
# 1 = permitir respuesta demo si Hermes cae; 0 = fail-closed
HERMES_ALLOW_DEMO=1

# Asistente IA multi-proveedor (OpenAI Chat Completions compatible)
# Tiene prioridad sobre HERMES_* cuando está definido
# Presets: OpenAI, Azure OpenAI, Groq, Ollama, Hermes, o URL custom
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 1 = demo si el proveedor no responde; 0 = fail-closed
LLM_ALLOW_DEMO=1
# Solo si necesita endpoint en red privada en producción (Ollama/Hermes local)
# LLM_ALLOW_PRIVATE_URL=1

# Monitoreo judicial (estilo CausaMonitor) — host LexOpen local; APIs externas OK
# Datos + ClaveÚnica cifrada en Postgres de ESTE host (no SaaS CausaMonitor).
# Salida a OJV / CAPTCHA / partner API está permitida.
# Orden ingest: sidecar → scrape in-process → partner API → CSV
#
# === Setup recomendado (sidecar + CAPTCHA en el host) ===
#   npm run pjud:chromium          # una vez
#   npm run pjud:host              # sidecar :8787 (valida CAPTCHA_*)
#   # otra terminal: npm run web:host  (o npm run pjud:host -- --with-web)
#   npm run pjud:host:check        # solo valida env
#
# Partner API OpenAPI: GET {PJUD_API_URL}/causas/lookup?rit=&tribunal=
PJUD_API_URL=
PJUD_API_KEY=
# Sidecar scrape en su host: POST /causas/lookup y POST /mis-causas
# Recomendado local: http://127.0.0.1:8787 + PJUD_SCRAPER_ALLOW_PRIVATE=1
PJUD_SCRAPER_URL=http://127.0.0.1:8787
PJUD_SCRAPER_KEY=
PJUD_SCRAPER_PORT=8787
# 1 = scrape OJV (Playwright + CAPTCHA). ToS risk. pjud:host fuerza 1 en el sidecar.
PJUD_PUBLIC_SCRAPE=1
# Proveedor CAPTCHA (BYOK). LexOpen es gratis; el solver lo paga/elige el estudio.
#   nopecha     → free ~100/día IP residencial (API_KEY opcional / free)
#   2captcha | capsolver | anticaptcha | capmonster → pay-per-solve (API_KEY requerida)
CAPTCHA_SOLVER_PROVIDER=nopecha
CAPTCHA_SOLVER_API_KEY=
# Fallback si el primario falla (p. ej. nopecha free bloqueado en VPS)
# CAPTCHA_SOLVER_FALLBACK=2captcha
# CAPTCHA_SOLVER_FALLBACK_API_KEY=
# 1 = automatizar ClaveÚnica → Mis Causas (requiere scrape o sidecar)
PJUD_CLAVEUNICA_SCRAPE=0
PJUD_CAUSAS_DAILY_SOLVE_BUDGET=50
PJUD_SESSION_TTL_MS=1500000
# Cache de resultados scrape (ms); default 6h
PJUD_CAUSAS_CACHE_TTL_MS=21600000
# Clave dedicada para vault ClaveÚnica (fallback: SESSION_SECRET)
PJUD_SECRETS_KEY=
# 1 = permite sidecar en red privada / localhost / Render .internal
PJUD_SCRAPER_ALLOW_PRIVATE=1
# Host web: minutos entre sync Mis Causas; 0 = off
PJUD_MIS_CAUSAS_INTERVAL_MINUTES=0
# 1 = permitir sync demo etiquetado sin API (0 con sidecar live)
PJUD_ALLOW_DEMO=0
# Webhook asíncrono de un partner: firma HMAC con timestamp + cuerpo.
PJUD_WEBHOOK_SECRET=
# Secret opcional para cron: POST /api/causas/monitoreo con header x-cron-secret
CRON_SECRET=
# Host web local: minutos entre sincronizaciones; 0 = scheduler desactivado.
PJUD_SYNC_INTERVAL_MINUTES=0
# Intervalo entre syncs por causa (default 240 = 4h, paridad CausaMonitor Pro)
# En Render Blueprint: PJUD_SYNC_INTERVAL_MINUTES=240
# Parallelismo del worker de cola (CausaMonitor usa 5)
PJUD_SYNC_CONCURRENCY=5
# Host web: minutos entre digests PJUD; 0 = off
PJUD_DIGEST_INTERVAL_MINUTES=0
# 1 = backup PDF de escritos/receptor tras sync exitoso
PJUD_PDF_BACKUP=0
# Host web local: backups automáticos; 0 = scheduler desactivado.
# El directorio debe estar fuera de LEXOPEN_DATA_DIR.
LEXOPEN_BACKUP_INTERVAL_MINUTES=0
LEXOPEN_BACKUP_DIR=
LEXOPEN_BACKUP_KEEP=7

OBSIDIAN_VAULT_PATH=./obsidian-vault
OBSIDIAN_REST_URL=http://127.0.0.1:27123
OBSIDIAN_REST_TOKEN=
# 1 = permite Obsidian REST en loopback cuando NODE_ENV=production (Host local)
OBSIDIAN_ALLOW_PRIVATE_URL=1

# OCR local para PDFs escaneados (Tesseract; Poppler solo como fallback Windows)
OCR_ENABLED=1
OCR_LANGUAGE=spa+eng
OCR_TESSERACT_BIN=tesseract
OCR_PDFTOPPM_BIN=pdftoppm
OCR_MAX_PAGES=20
OCR_TIMEOUT_MS=30000

# Almacenamiento local del Host (producción local: disco del PC, no nube)
STORAGE_PATH=./storage
# Host web local en NODE_ENV=production: 1 permite filesystem bajo STORAGE_PATH
LEXOPEN_ALLOW_LOCAL_PRODUCTION_STORAGE=1
# Con 1, /api/health falla si no hay storage persistente listo (S3 o local permitido)
LEXOPEN_REQUIRE_PERSISTENT_STORAGE=0
# Object storage S3-compatible (opcional; no requerido para Host local)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

NEXT_PUBLIC_APP_NAME=LexOpen
# URL canónica (p. ej. Tailscale del PC principal). Vacío = Host de la petición.
# NEXT_PUBLIC_APP_URL=http://pc-estudio.tailXXXX.ts.net:3000
# Orígenes extra CSRF (coma-separados), útil Host local + URL Tailscale.
# En producción, si define NEXT_PUBLIC_APP_URL o LEXOPEN_TRUSTED_ORIGINS,
# el header Host deja de ampliar la allowlist CSRF (evita Host confusion).
# LEXOPEN_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://pc-estudio.tailXXXX.ts.net:3000
# Cookie Secure: 1 fuerza Secure; 0 fuerza off (Host local http). Por defecto
# sigue el esquema de NEXT_PUBLIC_APP_URL (https→Secure).
# LEXOPEN_COOKIE_SECURE=0
# LEXOPEN_DESKTOP=1
# LEXOPEN_DATA_DIR=
# En Desktop Host, STORAGE_PATH debe vivir bajo LEXOPEN_DATA_DIR (no bajo el .app)
# STORAGE_PATH=
PORT=3000
# Solo marque 1 si un proxy confiable sobrescribe X-Forwarded-For/X-Real-IP.
LEXOPEN_TRUSTED_PROXY=0
